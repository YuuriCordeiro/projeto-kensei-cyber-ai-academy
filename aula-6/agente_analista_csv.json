        "language": "python",
        "code": "import pandas as pd\nimport io\nimport base64\n\n# Acessando dados do nó Set anterior para pegar o CSV codificado\ncsv_b64 = _inputs['Prepare Inputs']['json']['csv_base64']\n\nif not csv_b64:\n    return \"Erro: Nenhum arquivo CSV foi detectado no anexo.\"\n\ntry:\n    # Decodifica e carrega o DataFrame\n    decoded = base64.b64decode(csv_b64).decode('utf-8')\n    df = pd.read_csv(io.StringIO(decoded))\n    \n    # Retorna metadados e amostra para o Agente raciocinar sobre a resposta final\n    return f\"Colunas: {list(df.columns)}. Info: {df.shape}. Amostra:\\n{df.head(3).to_string()}\"\nexcept Exception as e:\n    return f\"Erro ao processar CSV com Pandas: {str(e)}\""
